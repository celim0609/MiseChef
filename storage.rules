rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    function signedIn() {
      return request.auth != null;
    }

    function ownsPath(userId) {
      return signedIn() && request.auth.uid == userId;
    }

    function isSuperAdmin() {
      return signedIn()
        && (
          request.auth.token.email == 'celim0609@gmail.com'
          || (
            firestore.exists(/databases/(default)/documents/users/$(request.auth.uid))
            && firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.role == 'super_admin'
          )
        );
    }

    function canManageWorkspace(workspaceId) {
      return signedIn()
        && (
          (
            firestore.exists(/databases/(default)/documents/workspaces/$(workspaceId))
            && firestore.get(/databases/(default)/documents/workspaces/$(workspaceId)).data.ownerId == request.auth.uid
          )
          || (
            firestore.exists(/databases/(default)/documents/workspaceMembers/$(workspaceId + "_" + request.auth.uid))
            && firestore.get(/databases/(default)/documents/workspaceMembers/$(workspaceId + "_" + request.auth.uid)).data.status == 'Active'
            && firestore.get(/databases/(default)/documents/workspaceMembers/$(workspaceId + "_" + request.auth.uid)).data.role in ['Owner', 'Manager']
          )
        );
    }

    function canManageStoreProducts(workspaceId) {
      return signedIn()
        && (
          (
            firestore.exists(/databases/(default)/documents/workspaces/$(workspaceId))
            && firestore.get(/databases/(default)/documents/workspaces/$(workspaceId)).data.ownerId == request.auth.uid
          )
          || (
            firestore.exists(/databases/(default)/documents/workspaceMembers/$(workspaceId + "_" + request.auth.uid))
            && firestore.get(/databases/(default)/documents/workspaceMembers/$(workspaceId + "_" + request.auth.uid)).data.status == 'Active'
            && firestore.get(/databases/(default)/documents/workspaceMembers/$(workspaceId + "_" + request.auth.uid)).data.role in ['Owner', 'Manager', 'Head Chef']
          )
        );
    }

    function isActiveWorkspaceMember(workspaceId) {
      return signedIn()
        && (
          (
            firestore.exists(/databases/(default)/documents/workspaces/$(workspaceId))
            && firestore.get(/databases/(default)/documents/workspaces/$(workspaceId)).data.ownerId == request.auth.uid
          )
          || (
            firestore.exists(/databases/(default)/documents/workspaceMembers/$(workspaceId + "_" + request.auth.uid))
            && firestore.get(/databases/(default)/documents/workspaceMembers/$(workspaceId + "_" + request.auth.uid)).data.status == 'Active'
          )
        );
    }

    function isCommittedPersonalExpenseReceipt(workspaceId, userId, expenseId, fileName) {
      return firestore.exists(/databases/(default)/documents/personalExpenses/$(expenseId))
        && firestore.get(/databases/(default)/documents/personalExpenses/$(expenseId)).data.workspaceId == workspaceId
        && firestore.get(/databases/(default)/documents/personalExpenses/$(expenseId)).data.createdBy == userId
        && firestore.get(/databases/(default)/documents/personalExpenses/$(expenseId)).data.receiptPath
          == "personal-expenses/" + workspaceId + "/" + userId + "/" + expenseId + "/" + fileName;
    }

    function validImageUpload(maxBytes) {
      return request.resource != null
        && request.resource.size <= maxBytes
        && request.resource.contentType in ['image/jpeg', 'image/png', 'image/webp'];
    }

    function validInvoiceUpload() {
      return request.resource != null
        && request.resource.size <= 10 * 1024 * 1024
        && request.resource.contentType in [
          'application/pdf',
          'image/jpeg',
          'image/png',
          'image/webp',
          'application/vnd.ms-excel',
          'application/vnd.openxmlformats-officedocument.spreadsheetml.sheet',
          'text/csv'
        ];
    }

    function hasAuthorizedInvoiceUpload(invoiceId, fileName) {
      return firestore.exists(/databases/(default)/documents/invoices/$(invoiceId))
        && firestore.get(/databases/(default)/documents/invoices/$(invoiceId)).data.createdBy == request.auth.uid
        && firestore.get(/databases/(default)/documents/invoices/$(invoiceId)).data.storageFileName == fileName;
    }

    function validPdfUpload(maxBytes) {
      return request.resource != null
        && request.resource.size <= maxBytes
        && request.resource.contentType == 'application/pdf';
    }

    function validResumeImport() {
      return request.resource != null
        && request.resource.size <= 10 * 1024 * 1024
        && request.resource.contentType in [
          'application/pdf',
          'application/vnd.openxmlformats-officedocument.wordprocessingml.document'
        ];
    }

    match /recipes/{userId}/{recipeId}/{allPaths=**} {
      allow read: if ownsPath(userId);
      allow create, update: if ownsPath(userId) && validImageUpload(10 * 1024 * 1024);
      allow delete: if ownsPath(userId);
    }

    match /approved-products/{productId}/{fileName} {
      allow read: if signedIn();
      allow create, update: if isSuperAdmin()
        && request.resource != null
        && request.resource.size <= 2 * 1024 * 1024
        && request.resource.contentType == 'image/jpeg';
      allow delete: if isSuperAdmin();
    }

    match /stores/{workspaceId}/products/{productId}/{fileName} {
      allow read: if true;
      allow create, update: if canManageStoreProducts(workspaceId)
        && validImageUpload(10 * 1024 * 1024);
      allow delete: if canManageStoreProducts(workspaceId);
    }

    match /stores/{workspaceId}/{allPaths=**} {
      allow read: if true;
      allow create, update: if canManageWorkspace(workspaceId)
        && validImageUpload(10 * 1024 * 1024);
      allow delete: if canManageWorkspace(workspaceId);
    }

    // Guest receipts are written only by the trusted checkout callable using
    // the Admin SDK. Only the matching Store Owner or Manager may read them.
    match /store-payment-receipts/{workspaceId}/{orderId}/{fileName} {
      allow read: if canManageWorkspace(workspaceId);
      allow create, update, delete: if false;
    }

    match /users/{userId}/profile/{fileName} {
      allow read: if ownsPath(userId);
      allow create, update: if ownsPath(userId) && validImageUpload(5 * 1024 * 1024);
      allow delete: if ownsPath(userId);
    }

    match /users/{userId}/portfolio/cover/{fileName} {
      allow read: if ownsPath(userId);
      allow create, update: if ownsPath(userId) && validImageUpload(10 * 1024 * 1024);
      allow delete: if ownsPath(userId);
    }

    match /users/{userId}/portfolio/gallery/{fileName} {
      allow read: if ownsPath(userId);
      allow create, update: if ownsPath(userId) && validImageUpload(10 * 1024 * 1024);
      allow delete: if ownsPath(userId);
    }

    match /users/{userId}/portfolio/certificates/{certificateId}/{fileName} {
      allow read: if ownsPath(userId);
      allow create, update: if ownsPath(userId) && (
        validImageUpload(10 * 1024 * 1024) || validPdfUpload(15 * 1024 * 1024)
      );
      allow delete: if ownsPath(userId);
    }

    match /users/{userId}/portfolio/resume/{fileName} {
      allow read: if ownsPath(userId);
      allow create, update: if ownsPath(userId) && validPdfUpload(15 * 1024 * 1024);
      allow delete: if ownsPath(userId);
    }

    match /users/{userId}/chef-profile/resume-imports/{fileName} {
      allow read: if ownsPath(userId);
      allow create: if ownsPath(userId) && validResumeImport();
      allow update: if false;
      allow delete: if ownsPath(userId);
    }

    match /users/{userId}/chef-profile/certificates/{certificateId}/{fileName} {
      allow read: if ownsPath(userId);
      allow create, update: if ownsPath(userId) && validPdfUpload(10 * 1024 * 1024);
      allow delete: if ownsPath(userId);
    }

    match /users/{userId}/costing/invoices/{invoiceId}/{fileName} {
      allow read: if ownsPath(userId);
      allow create, update: if ownsPath(userId)
        && validInvoiceUpload()
        && hasAuthorizedInvoiceUpload(invoiceId, fileName);
      allow delete: if ownsPath(userId);
    }

    match /personal-expenses/{workspaceId}/{userId}/{expenseId}/{fileName} {
      allow read: if (ownsPath(userId) && isActiveWorkspaceMember(workspaceId))
        || canManageWorkspace(workspaceId);
      allow create: if ownsPath(userId)
        && isActiveWorkspaceMember(workspaceId)
        && !isCommittedPersonalExpenseReceipt(workspaceId, userId, expenseId, fileName)
        && (validImageUpload(10 * 1024 * 1024) || validPdfUpload(10 * 1024 * 1024));
      allow update: if ownsPath(userId)
        && isActiveWorkspaceMember(workspaceId)
        && !isCommittedPersonalExpenseReceipt(workspaceId, userId, expenseId, fileName)
        && (validImageUpload(10 * 1024 * 1024) || validPdfUpload(10 * 1024 * 1024));
      allow delete: if ownsPath(userId)
        && isActiveWorkspaceMember(workspaceId)
        && !isCommittedPersonalExpenseReceipt(workspaceId, userId, expenseId, fileName);
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
