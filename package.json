{
  "name": "react-example",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --port=3000 --host=0.0.0.0",
    "validate:beta-gate-self": "node scripts/validateBetaGateSelf.mjs --trusted-root .",
    "test:beta-gate": "node --test scripts/betaCapabilities.test.mjs",
    "validate:firebase-env": "node scripts/validateFirebaseEnv.mjs",
    "validate:firebase-env:beta": "FIREBASE_DEPLOY_TARGET=beta node scripts/validateFirebaseEnv.mjs",
    "validate:beta-capabilities": "node scripts/validateBetaCapabilities.mjs",
    "validate:beta-baseline": "FIREBASE_DEPLOY_TARGET=beta node scripts/validateBetaReleaseBaseline.mjs --trusted-root \"$MISECHEF_BETA_TRUSTED_GATE_ROOT\" --candidate-root .",
    "prebuild": "npm run validate:firebase-env",
    "build": "vite build && npm run prepare:store-social-template",
    "build:beta": "npm run validate:firebase-env:beta && npm run validate:beta-baseline && vite build --mode beta && npm run prepare:store-social-template && node scripts/generateBetaBuildManifest.mjs",
    "prepare:store-social-template": "node scripts/prepareStoreSocialTemplate.mjs",
    "deploy:beta": "node scripts/deployBeta.mjs",
    "verify:beta-release": "node scripts/deployBeta.mjs --verify-only",
    "test:beta-deployment-safety": "node --test scripts/betaDeploymentSafety.test.mjs",
    "test:beta-capabilities": "node --test scripts/betaCapabilities.test.mjs",
    "preview": "vite preview",
    "clean": "rm -rf dist server.js",
    "lint": "tsc --noEmit",
    "test:personal-expenses:model": "tsx --test src/modules/personal-expenses/*.test.ts",
    "test:quick-add": "tsx --test src/navigation/quickAdd.test.ts",
    "test:business-entitlements": "node --import tsx --test src/services/subscriptionService.test.ts src/services/entitlementBoundary.test.ts",
    "test:business-entitlements:rules": "firebase emulators:exec --config firebase.rules-test.json --only firestore,storage --project demo-misechef-business-entitlement-rules \"node --test tests/businessEntitlementAccessControl.test.mjs\"",
    "test:discover": "tsx --test src/components/discover/DiscoverCarousel.test.tsx",
    "test:personal-expenses:rules": "firebase emulators:exec --config firebase.rules-test.json --only firestore,storage --project demo-misechef-personal-expense-rules \"node --test tests/personalExpenseAccessControl.test.mjs\"",
    "test": "npm run test:store-payments:model && npm --prefix functions test && npm run test:store-payments:rules",
    "test:store-payments:model": "tsx --test src/modules/store/*.test.ts src/modules/store/*.test.tsx src/components/StoreNotificationBell.test.tsx src/regions/regionService.test.ts",
    "test:store-payments:rules": "firebase emulators:exec --config firebase.rules-test.json --only firestore,storage --project demo-misechef-store-payment-rules \"node --test tests/storePaymentAccessControl.test.mjs tests/storeOrderHistoryIntegration.test.mjs\"",
    "test:resume-import:rules": "firebase emulators:exec --config firebase.rules-test.json --only firestore --project demo-misechef-resume-import-rules \"node --test tests/resumeImportJobAccessControl.test.mjs\"",
    "test:chef-profile:rules": "firebase emulators:exec --config firebase.rules-test.json --only firestore,storage --project demo-misechef-chef-profile-rules \"node --test tests/chefProfileAccessControl.test.mjs\"",
    "test:homepage-promotions:rules": "firebase emulators:exec --config firebase.rules-test.json --only firestore,storage --project demo-misechef-homepage-promotion-rules \"node --test tests/homepagePromotionAccessControl.test.mjs\"",
    "test:store-sets:rules": "firebase emulators:exec --config firebase.rules-test.json --only firestore,storage --project demo-misechef-store-sets-rules \"node --test tests/storeSetsAccessControl.test.mjs\"",
    "test:recipes:rules": "firebase emulators:exec --config firebase.rules-test.json --only firestore --project demo-misechef-recipe-rules \"node --test tests/recipeWorkspaceAccessControl.test.mjs\"",
    "test:authorized-beta-business-migration": "node --test scripts/migrateAuthorizedBetaBusiness.test.mjs scripts/authorizedBetaBusinessMigrationCountry.test.mjs",
    "migration:authorized-beta-business:dry-run": "node scripts/migrateAuthorizedBetaBusiness.mjs --dry-run"
  },
  "dependencies": {
    "@stripe/react-stripe-js": "^6.8.0",
    "@stripe/stripe-js": "^9.12.0",
    "@tailwindcss/vite": "^4.1.14",
    "@vitejs/plugin-react": "^5.0.4",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "firebase": "^12.15.0",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^6.0.227",
    "qrcode": "^1.5.4",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "vite": "^6.2.3"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.1",
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@types/qrcode": "^1.5.6",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.25.0",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.3"
  }
}
