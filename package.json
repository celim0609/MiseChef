{
  "name": "react-example",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --port=3000 --host=0.0.0.0",
    "validate:firebase-env": "node scripts/validateFirebaseEnv.mjs",
    "validate:firebase-env:beta": "FIREBASE_DEPLOY_TARGET=beta node scripts/validateFirebaseEnv.mjs",
    "prebuild": "npm run validate:firebase-env",
    "build": "vite build",
    "build:beta": "npm run validate:firebase-env:beta && vite build --mode beta",
    "deploy:beta": "npm run build:beta && FIREBASE_DEPLOY_TARGET=beta firebase deploy --project beta",
    "preview": "vite preview",
    "clean": "rm -rf dist server.js",
    "lint": "tsc --noEmit",
    "test": "npm run test:store-payments:model && npm --prefix functions test && npm run test:store-payments:rules",
    "test:store-payments:model": "tsx --test src/modules/store/*.test.ts src/modules/store/*.test.tsx src/components/StoreNotificationBell.test.tsx src/regions/regionService.test.ts",
    "test:store-payments:rules": "firebase emulators:exec --only firestore,storage --project demo-misechef-store-payment-rules \"node --test tests/storePaymentAccessControl.test.mjs tests/storeOrderHistoryIntegration.test.mjs\"",
    "test:chef-profile:rules": "firebase emulators:exec --only firestore,storage --project demo-misechef-chef-profile-rules \"node --test tests/chefProfileAccessControl.test.mjs\""
  },
  "dependencies": {
    "@stripe/react-stripe-js": "^6.8.0",
    "@stripe/stripe-js": "^9.12.0",
    "@tailwindcss/vite": "^4.1.14",
    "@vitejs/plugin-react": "^5.0.4",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "firebase": "^12.15.0",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^6.0.227",
    "qrcode": "^1.5.4",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "vite": "^6.2.3"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.1",
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@types/qrcode": "^1.5.6",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.25.0",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.3"
  }
}
